# --- LLM (optional — app falls back to a deterministic mock without a key) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embedding ---
# "sbert" = real model (needs ~400MB download on first run) | "hash" = offline stub
EMBEDDING_BACKEND=sbert
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DEVICE=cpu

# --- Vector store ---
CHROMA_PERSIST_DIR=storage/chroma
COLLECTION_NAME=vn_knowledge_base

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SCORE_THRESHOLD=0.15

# --- Chat memory ---
MAX_HISTORY_TURNS=6

# --- Default docs folder for scripts/ingest.py ---
DATA_DIR=data/sample_docs
